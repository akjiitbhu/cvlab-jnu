# Copy to .env for local development. NEVER commit .env — it is gitignored.
# On your host (Render, Railway, a JNU server) set these in the dashboard or
# service file instead of using a file.

# ---------------------------------------------------------------- database
# MongoDB Atlas gives you this string under "Connect" → "Drivers".
# Replace <password> with the database user's password and keep /cvlab as the
# database name. URL-encode any of  : / ? # [ ] @  that appear in the password.
MONGODB_URI=mongodb+srv://cvlab_app:<password>@cluster0.xxxxx.mongodb.net/cvlab?retryWrites=true&w=majority

# ------------------------------------------------------------------ secret
# Signs the admin session cookie. At least 32 characters; 64 is better.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it signs everyone out. Never commit the real value.
JWT_SECRET=replace-me-with-64-random-hex-characters

# ------------------------------------------------------------ site origin
# Where the public pages are served from. The pages live on GitHub Pages and
# the API lives here, so they are different origins and the browser needs the
# API to say the pages may read it.
#
# Comma separate more than one. No trailing slash. Exact scheme and host.
#   https://<username>.github.io          user/organisation site
#   https://<username>.github.io          project site too — the origin is the
#                                         host only, the /repo-name path is not
#                                         part of it
# LEAVE THIS UNSET for a single-host deployment — Azure App Service, your own
# server, or local development — where Node serves the pages and the API from
# the same origin. There is no second origin to allow, and setting it anyway
# just grants a stranger's github.io a pointless read.
#
# Only uncomment it for the split deployment, where the pages are on GitHub
# Pages and the API is elsewhere.
#SITE_ORIGIN=https://your-username.github.io

# ----------------------------------------------------------------- runtime
# Set to production on your host. It turns on Secure cookies and HSTS, so
# leave it unset locally or the login will not work over plain http.
NODE_ENV=development

# Your host sets this itself; 3000 is only the local default.
PORT=3000

# ------------------------------------------- metrics refresh (optional)
# Used by scripts/refresh-metrics.js.
ORCID=0000-0003-1736-9157
OPENALEX_MAILTO=ankitjaiswal@jnu.ac.in
